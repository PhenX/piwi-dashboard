{
  "name": "@piwitests/core",
  "version": "0.18.2",
  "description": "Pure cross-cutting logic and wire shapes shared by the Piwi Dashboard app and the Playwright reporter",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./codeowners": "./src/codeowners.ts",
    "./gate": "./src/gate.ts",
    "./locator-generation": "./src/locator-generation.ts",
    "./locator-fingerprint": "./src/locator-fingerprint.ts",
    "./locator-healing-types": "./src/locator-healing-types.ts",
    "./error-text": "./src/error-text.ts",
    "./locator-methods": "./src/locator-methods.ts",
    "./status-classify": "./src/status-classify.ts",
    "./step-analysis": "./src/step-analysis.ts",
    "./test-meta": "./src/test-meta.ts",
    "./wire": "./src/wire.ts"
  },
  "scripts": {
    "core:test": "vitest run",
    "core:test:watch": "vitest",
    "core:lint": "oxlint --config oxlint.config.mts .",
    "core:lint:fix": "oxlint --config oxlint.config.mts . --fix",
    "core:format": "oxfmt --config oxfmt.config.mts --write \"src/\" \"tests/\"",
    "core:format:check": "oxfmt --config oxfmt.config.mts --check \"src/\" \"tests/\"",
    "test": "npm run core:test"
  }
}
