{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // tsup bundles the package now, so tsc is typecheck-only and resolves like
    // the bundler does — which lets it consume @piwitests/core's TS source.
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": "src",
    "strict": true,
    "noEmit": true,
    // tsup's dts build injects `baseUrl: "."`, which TypeScript 6 flags as a
    // deprecated option unless this is set.
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
