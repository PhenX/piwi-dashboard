{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["app/**/*.ts", "tests/**/*.ts", "nitro.config.ts", "playwright.config.ts", "playwright.manual-reporter.config.ts", "playwright.shared.ts"]
}
